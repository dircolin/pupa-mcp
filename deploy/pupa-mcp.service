[Unit]
Description=PUPA MCP server (Streamable HTTP + OAuth) - Claude/ChatGPT connector
After=network.target pupa-proxy.service

[Service]
Type=simple
User=pupa
Group=pupa
WorkingDirectory=/home/pupa/pupa-mcp
Environment=PORT=8790
Environment=HOST=127.0.0.1
Environment=PUPA_MCP_PUBLIC=https://proxy.pupastage.com/mcp
Environment=PUPA_PROXY_BASE=https://proxy.pupastage.com
Environment=PUPA_MCP_DATA=/home/pupa/pupa-mcp/data
ExecStart=/usr/bin/node /home/pupa/pupa-mcp/src/server.mjs --http
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
